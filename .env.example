# Where the LLM comes from: "litellm" (a LiteLLM proxy) or "anthropic" (the Claude API)
JPLEARN_PROVIDER=litellm

# LiteLLM proxy (OpenAI-compatible endpoint), when JPLEARN_PROVIDER=litellm
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-...

# Claude API, when JPLEARN_PROVIDER=anthropic. Or skip the key and run `ant auth login`.
# ANTHROPIC_API_KEY=sk-ant-...
# Thinking effort: low | medium | high | xhigh | max (unset = the model's default)
# JPLEARN_EFFORT=medium

# Model name: a Claude model ID (e.g. claude-sonnet-5-5, claude-opus-5-5), or for LiteLLM
# the name configured on the proxy
JPLEARN_MODEL=claude-sonnet-5-5
# Anki deck new flashcards go into (unless you name one in chat)
JPLEARN_DECK=jplearn
# AnkiConnect address (default shown)
# ANKI_CONNECT_URL=http://localhost:8765
# Hides pydantic-ai's startup banner
PYDANTIC_AI_NO_BANNER=1
